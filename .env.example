# Cloud LLM Provider Keys (server-side only — never exposed to browser)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local LLM (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
# Optional comma-separated extra hostnames permitted by SSRF guard (e.g. my-gpu-box.lan)
ALLOWED_LOCAL_HOSTS=

# Local Speech-to-Text (STT) Engines
# Whisper.cpp CLI binary & .bin model path or directory
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
WHISPER_MODELS_DIR=
# Faster-Whisper Python interpreter & local CTranslate2 model directory
WHISPER_PYTHON_BIN=
FASTER_WHISPER_MODEL=
# Optional local OpenAI-compatible Whisper HTTP endpoint
LOCAL_STT_URL=

# Local Text-to-Speech (TTS) Engines
# Piper TTS binary & .onnx voice model path or directory
PIPER_BIN=
PIPER_MODEL=
PIPER_VOICES_DIR=
# Kokoro TTS HTTP server URL or local ONNX model/voice files
KOKORO_URL=
KOKORO_MODEL=
KOKORO_VOICES=
# Optional local Piper HTTP server URL
LOCAL_TTS_URL=
